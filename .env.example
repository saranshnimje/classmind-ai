# Copy to `.env` and adjust as needed. All values are optional; the app has
# safe local-first defaults. Environment variables use the CLASSMIND_ prefix.

# --- storage --------------------------------------------------------------
# CLASSMIND_DATA_DIR=./data
# CLASSMIND_DATABASE_URL=sqlite:///./data/classmind.db

# --- analysis defaults ----------------------------------------------------
# CLASSMIND_SAMPLE_INTERVAL_SEC=2
# CLASSMIND_MIN_PRESENCE_SEC=30
# CLASSMIND_LATE_AFTER_SEC=300
# CLASSMIND_WINDOW_SEC=300
# CLASSMIND_MAX_ANALYSIS_FRAMES=900
# CLASSMIND_ANALYSIS_MAX_WIDTH=640

# --- detector -------------------------------------------------------------
# auto | yolo | hog | none
# CLASSMIND_DETECTOR_BACKEND=auto
# CLASSMIND_YOLO_MODEL=yolov8n.pt
# CLASSMIND_YOLO_CONFIDENCE=0.35
# CLASSMIND_YOLO_IMGSZ=480
# Set false for fully offline operation; place weights in data/models first.
# CLASSMIND_ALLOW_MODEL_DOWNLOAD=true

# --- audio VAD ------------------------------------------------------------
# auto | energy | silero
# CLASSMIND_VAD_BACKEND=auto

# --- optional local LLM (Ollama) ------------------------------------------
# CLASSMIND_OLLAMA_ENABLED=false
# CLASSMIND_OLLAMA_URL=http://127.0.0.1:11434
# CLASSMIND_OLLAMA_MODEL=llama3.2
# CLASSMIND_OLLAMA_TIMEOUT_SEC=60

# --- uploads / limits -----------------------------------------------------
# CLASSMIND_MAX_UPLOAD_MB=512
# CLASSMIND_MAX_MEDIA_DURATION_SEC=14400
# CLASSMIND_MIN_MEDIA_DURATION_SEC=1

# --- live capture ---------------------------------------------------------
# CLASSMIND_LIVE_CAMERA_INDEX=0
# CLASSMIND_LIVE_MAX_SECONDS=300

# --- logging --------------------------------------------------------------
# CLASSMIND_LOG_LEVEL=INFO
