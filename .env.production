# Vercel deployment — frontend environment
# REQUIRED: Set VITE_API_BASE in Vercel project settings (Dashboard > Project > Environment Variables)
# Example (replace with your actual Render backend URL after deployment):
# VITE_API_BASE=https://classmind-ai.onrender.com/api
# The default /api works when the backend and frontend are co-deployed or proxied together.
VITE_DEPLOYMENT_MODE=hosted
# Required for Vercel production: set VITE_API_BASE in Vercel Dashboard > Project > Environment Variables
# Example: VITE_API_BASE=https://classmind-ai.onrender.com/api
VITE_API_BASE=/api
